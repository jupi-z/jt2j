# Server-side canonical site origin. Use the real HTTPS origin for deployment.
SITE_URL=http://localhost:3000

# CMS commands require a persistent PostgreSQL database and a private random secret.
DATABASE_URL=postgresql://jt2j:change-me@localhost:5432/jt2j
PAYLOAD_SECRET=replace-with-a-random-secret-at-least-32-characters
# Local files live outside public/. Mount .media persistently for local production.
MEDIA_STORAGE=local
# For private S3-compatible storage, use MEDIA_STORAGE=s3 and configure these.
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
