# Server-side canonical site origin. Use the real HTTPS origin for deployment.
SITE_URL=http://localhost:3000

# Server-only transactional lead notification transport. Never expose these in client code.
LEAD_MAIL_SINK_URL=http://localhost:8025/api/messages
LEAD_NOTIFICATION_TO=contact@example.test
LEAD_NOTIFICATION_FROM=no-reply@example.test
LEAD_POLICY_VERSION=v1
LEAD_RATE_LIMIT_MAX=5
# Only enable when the front proxy strips and replaces this header before forwarding.
TRUST_PROXY=false
# Only TRUST_PROXY=true with a proxy that strips/replaces this header is a security boundary.
# Otherwise the first request receives a signed per-client cookie; spoofable headers are never bucketed.
TRUSTED_PROXY_IP_HEADER=x-forwarded-for
# Optional secret for the signed fallback rate-limit cookie; PAYLOAD_SECRET is used when unset.
LEAD_RATE_LIMIT_COOKIE_SECRET=

# CMS commands require a persistent PostgreSQL database and a private random secret.
DATABASE_URL=postgresql://jt2j:change-me@localhost:5432/jt2j
PAYLOAD_SECRET=replace-with-a-random-secret-at-least-32-characters
CSRF_SECRET=replace-with-a-different-random-secret-at-least-32-characters
# Local files live outside public/. Mount .media persistently for local production.
MEDIA_STORAGE=local
# For private S3-compatible storage, use MEDIA_STORAGE=s3 and configure these.
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
